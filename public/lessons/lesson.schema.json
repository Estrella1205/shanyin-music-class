{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:shengru:lesson:v1",
 "title":"声入山野可验证音乐课对象",
 "type":"object",
 "required":["id","version","title","source","teaching","events","audio","objectives","constraints","activities"],
 "properties":{
  "id":{"type":"string","minLength":1},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"title":{"type":"string"},
  "source":{"type":"object","required":["title","url","pdfPage","location","key","tonicMidi","meter","rights"],"properties":{"url":{"type":"string","format":"uri"},"pdfPage":{"type":"integer","minimum":1},"tonicMidi":{"type":"integer","minimum":0,"maximum":127},"meter":{"type":"array","items":{"type":"integer"},"minItems":2,"maxItems":2}}},
  "teaching":{"type":"object","required":["key","tonicMidi","transposeSemitones","meter","bpm","slowBpm","beats","measures","pitchRange"],"properties":{"bpm":{"type":"number","minimum":30,"maximum":240},"slowBpm":{"type":"number","minimum":30,"maximum":240},"beats":{"type":"number","exclusiveMinimum":0},"measures":{"type":"integer","minimum":1}}},
  "events":{"type":"array","minItems":1,"items":{"type":"object","required":["id","measure","beat","degree","octave","midi","pitch","durationBeats"],"properties":{"id":{"type":"string"},"measure":{"type":"integer","minimum":1},"beat":{"type":"number","minimum":0},"degree":{"type":"integer","minimum":1,"maximum":7},"octave":{"type":"integer"},"midi":{"type":"integer","minimum":0,"maximum":127},"pitch":{"type":"string"},"durationBeats":{"type":"number","exclusiveMinimum":0}}}},
  "audio":{"type":"object","required":["sampleRate","channels","bitDepth","reference","slow","countIn","gateRatio","provenance"],"properties":{"sampleRate":{"type":"integer","minimum":8000},"channels":{"const":1},"bitDepth":{"const":16},"gateRatio":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
  "objectives":{"type":"array","minItems":1,"items":{"type":"object","required":["id","text","evidence"]}},
  "constraints":{"type":"object","required":["minMinutes","maxMinutes","minStudents","maxStudents","equipmentAlternatives"]},
  "activities":{"type":"array","minItems":1,"items":{"type":"object","required":["id","title","weight","goal","teacher","student"],"properties":{"weight":{"type":"number","exclusiveMinimum":0}}}}
 }
}
